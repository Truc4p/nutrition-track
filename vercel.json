{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "web-ui/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(api|ai|nlp)/.*",
      "dest": "api/index.py"
    },
    {
      "src": "/images/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*\\.(js|css|html|png|jpg|jpeg|gif|svg|ico|md))",
      "dest": "web-ui/$1"
    },
    {
      "src": "/()",
      "dest": "web-ui/home.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  }
}

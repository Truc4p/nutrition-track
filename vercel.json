{
  "rewrites": [
    {
      "source": "/(api|ai|nlp)/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/images/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*\\.js)",
      "destination": "/web-ui/$1"
    },
    {
      "source": "/(.*\\.css)",
      "destination": "/web-ui/$1"
    },
    {
      "source": "/(.*\\.html)",
      "destination": "/web-ui/$1"
    },
    {
      "source": "/",
      "destination": "/web-ui/home.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 10
    }
  }
}

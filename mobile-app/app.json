{
  "expo": {
    "name": "Track Nutrition",
    "slug": "track-nutrition",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3498db"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tracnutrition.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3498db"
      },
      "package": "com.tracnutrition.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Track Nutrition to access your camera to take photos of meals."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Track Nutrition to access your photos to upload meal images."
        }
      ]
    ]
  }
}
